{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/wedding-updates.schema.json",
  "title": "Approved public updates",
  "description": "Day-of notices shown in the website's Updates section. Add an entry only after the family content approver has signed off the exact wording.",
  "type": "object",
  "required": ["updates"],
  "properties": {
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "posted_at", "title", "message", "approved_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "posted_at": { "type": "string", "format": "date-time", "description": "ISO 8601 with offset, e.g. 2026-11-20T13:10:00+05:30" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "message": { "type": "string", "minLength": 1, "maxLength": 400 },
          "approved_by": { "type": "string", "minLength": 1, "description": "Name of the family content approver. Never rendered." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
