{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/wedding-event-data.schema.json",
  "title": "Wedding guest experience event data",
  "type": "object",
  "required": ["couple", "event_dates", "venue", "schedule", "notification_material", "guest_services", "open_questions"],
  "properties": {
    "couple": {
      "type": "object",
      "required": ["partner_one", "partner_two"],
      "properties": {
        "partner_one": { "type": "string", "minLength": 1 },
        "partner_two": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "event_dates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "date" }
    },
    "venue": {
      "type": "object",
      "required": ["name", "locality", "address", "maps_url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "locality": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "maps_url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "array",
      "items": { "$ref": "#/$defs/scheduleItem" }
    },
    "notification_material": {
      "type": "array",
      "items": { "$ref": "#/$defs/notificationItem" }
    },
    "guest_services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "availability", "display_on_website"],
        "properties": {
          "name": { "type": "string" },
          "availability": { "type": "string" },
          "display_on_website": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "owner", "needed_by"],
        "properties": {
          "question": { "type": "string" },
          "owner": { "type": "string" },
          "needed_by": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "scheduleItem": {
      "type": "object",
      "required": ["id", "date", "start_time", "title", "location", "timing_status", "display_on_website", "channels"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "date": { "type": "string", "format": "date" },
        "start_time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "end_time": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "title": { "type": "string" },
        "location": { "type": ["string", "null"] },
        "timing_status": { "enum": ["confirmed", "provisional"] },
        "display_on_website": { "const": true },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["website", "whatsapp"] }
        }
      },
      "additionalProperties": false
    },
    "notificationItem": {
      "type": "object",
      "required": ["id", "date", "time", "title", "timing_status", "channels", "display_on_website"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "title": { "type": "string" },
        "timing_status": { "enum": ["confirmed", "provisional"] },
        "channels": { "type": "array", "minItems": 1, "items": { "const": "whatsapp" } },
        "display_on_website": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
